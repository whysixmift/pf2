# -----------------------------------------------------------------------------
# Portfolio CMS Environment Variables
# -----------------------------------------------------------------------------

# Database configuration
# When using Docker Compose, the database host is 'db'
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=portfolio_secure_pass
POSTGRES_DB=portfolio
DATABASE_URL=postgres://portfolio:portfolio_secure_pass@db:5432/portfolio

# Authentication
# Must be a secure, random string in production
JWT_SECRET=generate_a_secure_random_string

# Server configuration
PORT=3000
NODE_ENV=development

# Optional: External services (like Hackatime, Analytics, etc.)
# HACKATIME_API_KEY=your_key_here
